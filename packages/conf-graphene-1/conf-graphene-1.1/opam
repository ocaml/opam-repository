opam-version: "2.0"
synopsis: "Virtual package relying on a Graphene 1 (with GObject types) system installation"
description:
  "This package can only be installed if the Graphene 1 (with GObject types) development files (pkg-config module graphene-gobject-1.0) are installed on the system."
maintainer: "hello@chrisarmstrong.dev"
authors: ["Chris Armstrong"]
license: "LGPL-2.1-or-later WITH OCaml-LGPL-linking-exception"
homepage: "https://github.com/chris-armstrong/ocgtk"
bug-reports: "https://github.com/chris-armstrong/ocgtk/issues"
depends: [
  "conf-pkg-config" {build}
  "conf-glib-2"
]

# System package that provides graphene-gobject-1.0.pc on each supported platform
depexts: [
  # Debian/Ubuntu
  ["libgraphene-1.0-dev"] {os-family = "debian"}

  # Fedora/CentOS Stream
  ["graphene-devel"] {os-distribution = "fedora"}
  ["graphene-devel"] {os-distribution = "centos"}

  # openSUSE
  ["libgraphene-devel"] {os-distribution = "opensuse-leap" | os-distribution = "opensuse-tumbleweed"}

  # Alpine Linux
  ["graphene-dev"] {os-distribution = "alpine"}

  # Arch Linux
  ["graphene"] {os-distribution = "arch"}

  # macOS via Homebrew
  ["graphene"] {os = "macos" & os-distribution = "homebrew"}

  # FreeBSD
  ["graphene"] {os = "freebsd"}
]

build: [
  ["pkg-config" "--short-errors" "--print-errors" "graphene-gobject-1.0"]
]

# Windows is unsupported until the opam MSYS2 UCRT64 toolchain is available.
available: os != "win32"
flags: conf
