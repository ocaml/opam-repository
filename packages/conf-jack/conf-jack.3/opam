build: [
  "pkgconf" {os = "win32" & os-distribution != "cygwinports"}
  "pkg-config" {os != "win32" | os-distribution = "cygwinports"}
  "--exists"
  "jack"
]
depends: [
  "conf-pkg-config" {build}
]
depexts: [
  ["jack-dev"] {os-distribution = "alpine"}
  ["jack-devel"] {os-distribution = "void"}
  ["media-sound/jack2"] {os-distribution = "gentoo"}
  ["pipewire-jack-audio-connection-kit-devel"]
    {(os-family = "fedora" | os-family = "rhel") &
     (os-distribution = "fedora" | os-version >= "9")}
  ["epel-release" "jack-audio-connection-kit-devel"]
    {os-family = "rhel" & os-version < "9"}
  ["oracle-epel-release-el8" "jack-audio-connection-kit-devel"]
    {os-distribution = "ol" & os-version < "9"}
  ["pipewire-libjack-0_3-devel"]
    {os-family = "suse" | os-family = "opensuse"}
  ["libjack-jackd2-dev"] {os-family = "debian" | os-family = "ubuntu"}
  ["libjack2"] {os-distribution = "nixos"}
  ["jack"]
    {os-family = "arch" | os = "openbsd" |
     os = "macos" & (os-distribution = "homebrew" | os-distribution = "macports")}
  ["audio/jack"] {os = "freebsd"}
]
synopsis: "Virtual package relying on jack"
description:
  "This package can only install if the jack library is installed on the system."
flags: conf
