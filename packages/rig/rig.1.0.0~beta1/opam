doc: "https://raven-ml.dev/docs/"
bug-reports: "https://github.com/raven-ml/raven/issues"
depends: [
  "ocaml" {>= "5.5.0"}
  "dune" {>= "3.22"}
  "conf-linux-libc-dev" {os = "linux"}
  "windtrap" {with-test & >= "0.3.1"}
  "mdx" {with-test}
  "thumper" {with-test & >= "0.1.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/raven-ml/raven.git"
x-maintenance-intent: ["(latest)"]
# rig addresses memory beyond what a 32-bit int holds, and its PCI drivers
# store values little-endian.
available: arch != "x86_32" & arch != "arm32" & arch != "ppc32" & arch != "s390x"
