opam-version: "2.0"
synopsis: "Compute devices for OCaml"
description:
  "Rig drives the host's CPU, Metal, CUDA, AMD and NVIDIA GPUs, files and remote machines as devices: their memory, the order of work across them, and the work itself. AMD and NVIDIA GPUs run through their kernel drivers or directly over PCI."
maintainer: ["Thibaut Mattio <thibaut.mattio@gmail.com>"]
authors: ["Thibaut Mattio <thibaut.mattio@gmail.com>"]
license:
  "ISC AND MIT AND NCSA AND Apache-2.0 WITH LLVM-exception AND Apache-2.0"
tags: ["gpu" "device" "driver" "metal" "cuda" "amd" "nvidia"]
homepage: "https://github.com/raven-ml/raven"
doc: "https://raven-ml.dev/docs/"
bug-reports: "https://github.com/raven-ml/raven/issues"
depends: [
  "ocaml" {>= "5.5.0"}
  "dune" {>= "3.21"}
  "windtrap" {with-test & >= "0.3.1"}
  "mdx" {with-test}
  "thumper" {with-test & >= "0.1.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/raven-ml/raven.git"
x-maintenance-intent: ["(latest)"]
# rig addresses memory beyond what a 32-bit int holds.
available: arch != "x86_32" & arch != "arm32" & arch != "ppc32"
# The drivers include the kernel's headers, which other distributions install
# with their C library's.
depexts: [
  ["linux-headers"] {os-distribution = "alpine"}
]
