  "ocaml" {>= "5.5.0"}
  "dune" {>= "3.21"}
  "nx" {= version}
  "rig" {= version}
  "tolk" {= version}
  "windtrap" {with-test & >= "0.3.1"}
  "ppx_windtrap" {with-test & >= "0.3.1"}
  "mdx" {with-test}
  "thumper" {with-test & >= "0.1.0"}
  "odoc" {with-doc}
]
