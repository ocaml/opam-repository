synopsis: "Yojson bindings for Elpi, as a plugin"
description: """
The plugin of the findlib package elpi-json: a program accumulates it with
`accumulate "+elpi-json".`, and its utilities written in Elpi with
`accumulate "+elpi-json/utils".`.
"""
x-maintenance-intent: ["(latest)"]
depends: [
  "ocaml" {>= "4.14.0"}
  "dune" {>= "3.17"}
  "elpi" {= version}
  "yojson" {>= "2.0"}
  "ppx_deriving" {build}
  "ppx_elpi" {build & = version}
]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs]
  ["dune" "runtest" "-p" name "-j" jobs] {with-test}
]
