synopsis: "Rocq proofs in a style that resembles non-mechanized mathematical proofs"
description: """
The Waterproof plugin for the Rocq proof assistant allows you to write Rocq proofs in a style that resembles handwritten mathematical proofs, designed to help university students with learning how to prove mathematical statements.
"""

license: "GPL-3.0-or-later"
homepage: "https://github.com/impermeable/rocq-waterproof"
dev-repo: "git+https://github.com/impermeable/rocq-waterproof.git"
bug-reports: "https://github.com/impermeable/rocq-waterproof/issues"

depends: [
  "ocaml" {>= "4.09.0"}
  "rocq-prover" {>= "9.0" & < "9.1" | = "dev"}
  "coq" {>= "9.0" & < "9.1" | = "dev"}
  "dune" {>= "3.8"}
]

build: [
  ["dune" "build" "-p" name "-j" jobs "@install"]
]

available: (arch != "s390x") & (arch != "ppc64")

