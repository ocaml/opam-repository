  "ocaml-unikraft-backend-qemu-arm64" {= version} |
  "ocaml-unikraft-backend-firecracker-arm64" {= version}
]
build: [
  [
    make
    "-j%{jobs}%"
    "LIB=%{lib}%"
    "SHARE=%{share}%"
    "OCUKARCH=arm64"
    "%{name}%.install"
  ]
]
