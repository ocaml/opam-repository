opam-version: "2.0"
synopsis: "Gradient-based optimizers for OCaml"
description:
  "Gradient-descent optimizers over parameter structures (SGD, Adam, AdamW, RAdam, LAMB, LARS, RMSprop, Adagrad, Adan, Lion, Adafactor, L-BFGS), whose states are structures too, and learning-rate schedules. Built on Nx with no autodiff dependency."
maintainer: ["Thibaut Mattio <thibaut.mattio@gmail.com>"]
authors: ["Thibaut Mattio <thibaut.mattio@gmail.com>"]
license: "ISC"
tags: ["optimization" "machine-learning" "gradient-descent"]
homepage: "https://github.com/raven-ml/raven"
doc: "https://raven-ml.dev/docs/"
bug-reports: "https://github.com/raven-ml/raven/issues"
depends: [
  "ocaml" {>= "5.5.0"}
  "dune" {>= "3.22"}
  "nx" {= version}
  "rune" {= version & with-test}
  "windtrap" {with-test & >= "0.3.1"}
  "mdx" {with-test}
  "thumper" {with-test & >= "0.1.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
