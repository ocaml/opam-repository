post-messages: [
  "Since Debian 9 Mysql is removed infavor of MariaDB. Expect issues like 'mysql.h not found'."
    { failure & os-distribution = "debian" }
  "Errors like 'MYSQL_OPT_SSL_MODE undeclared, did you mean MYSQL_OPT_SSL_CRL?' Highly likely means OCaml source is not in sync with current version of C code."
    { failure & (os-family = "suse" | os-family = "opensuse") }
]

