opam-version: "2.0"
synopsis: "Check that Python 3 can import SymPy"
description: """
Virtual package checking that python3 can import SymPy and compute an
antiderivative. System package dependencies are provided for Debian, Ubuntu,
Fedora and Arch Linux. On other systems, install SymPy in the Python environment
selected by python3 before installing this package.
"""
maintainer: "https://github.com/Sterling1111/spivak-rocq/issues"
authors: "Sterling Jeppson"
license: "MIT"
homepage: "https://www.sympy.org/"
bug-reports: "https://github.com/Sterling1111/spivak-rocq/issues"
flags: conf
depends: [ "conf-python-3" ]
build: [
  ["python3" "-c" "import sympy; x = sympy.Symbol('x'); assert sympy.integrate(x, x) == x**2/2"]
]
depexts: [
  ["python3-sympy"] {os-family = "debian" | os-family = "ubuntu"}
  ["python3-sympy"] {os-family = "fedora"}
  ["python-sympy"] {os-family = "arch"}
]
