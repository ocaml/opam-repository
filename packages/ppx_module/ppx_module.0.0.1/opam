bug-reports: "https://github.com/gammalphi/ppx_module/issues"
depends: [
  "dune" {>= "3.14"}
  "ppxlib" {>= "0.35.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
