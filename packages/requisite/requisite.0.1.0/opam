  "confidence-levels"
  "trust-boundary"
  "exhaustive-matching"
  "stale-data"
  "typestate"
  "validation"
  "taint-tracking"
  "freshness"
  "ttl"
  "monotonic-time"
  "data-safety"
]
homepage: "https://github.com/slepp/requisite-ocaml"
doc: "https://ocaml.org/p/requisite/latest/doc/Requisite/index.html"
bug-reports: "https://github.com/slepp/requisite-ocaml/issues"
depends: [
  "dune" {>= "3.11"}
  "ocaml" {>= "4.14"}
  "mtime" {>= "2.1.0" & < "3.0.0"}
  "odoc" {with-doc}
]
