  "dune" {>= "3.0"}
  "zarith" {>= "1.13"}
  "conf-rust-2024" {build}
  "odoc" {with-doc}
]
available:
  arch != "arm32" & arch != "ppc64" & arch != "s390x" & arch != "x86_32" &
  os != "win32"
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
