depends: [
  "dune" {>= "3.8"}
  "ocaml" {>= "4.08"}
  "cohttp" {= version}
  "odoc" {with-doc}
]
dev-repo: "git+https://github.com/mirage/ocaml-cohttp.git"
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@cohttp-top/runtest" {with-test}
    "@doc" {with-doc}
  ]
]
