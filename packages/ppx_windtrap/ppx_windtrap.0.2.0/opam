  "dune" {>= "3.21"}
  "ocaml" {>= "5.0"}
  "windtrap" {= version}
  "ppxlib" {>= "0.37.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
