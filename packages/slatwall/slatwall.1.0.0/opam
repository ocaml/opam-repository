opam-version: "2.0"
synopsis: "Slat panel TV media wall calculator: panel count, slats per panel, gap, TV size"
description: """
Computes how many slat (acoustic) wall panels a TV media wall needs, how many
slats fit on one panel with a minimum gap, the real gap when the slats are
spread evenly, the order quantity with one spare panel, and the size of a 16:9
TV from its diagonal. All lengths are in inches. No dependencies besides dune.
An interactive planner with the same arithmetic:
https://getmediawall.com/design-your-wall"""
maintainer: ["GetMediaWall <team@getmediawall.com>"]
authors: ["GetMediaWall <team@getmediawall.com>"]
license: "MIT"
homepage: "https://getmediawall.com/design-your-wall"
bug-reports: "https://github.com/getmediawall/ocaml-slatwall/issues"
dev-repo: "git+https://github.com/getmediawall/ocaml-slatwall.git"
depends: [
  "ocaml" {>= "4.08"}
  "dune" {>= "3.0"}
]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs "@install" "@runtest" {with-test} "@doc" {with-doc}]
]
