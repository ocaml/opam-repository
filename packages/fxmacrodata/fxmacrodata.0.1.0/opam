  "dune" {>= "3.7"}
  "ocaml" {>= "4.14"}
  "cohttp-lwt-unix" {>= "5.0"}
  "cohttp" {>= "5.0"}
  "cohttp-lwt" {>= "5.0"}
  "lwt" {>= "5.6"}
  "uri" {>= "4.0"}
  "yojson" {>= "2.0"}
  "alcotest" {>= "1.7" & with-test}
  "odoc" {with-doc}
]
