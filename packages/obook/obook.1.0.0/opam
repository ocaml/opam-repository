opam-version: "2.0"
synopsis:
  "Zero-allocation L3 limit order book and streaming HFT math in pure OCaml"
description:
  "Obook is a dependency-free, zero-allocation L3 matching engine and market microstructure library for OCaml. It packs 128-bit intermediate fixed-point math, pre-allocated order arenas with O(1) cancel/amend, Iceberg/FOK/IOC/Post-Only/STP order logic, NASDAQ ITCH 5.0 wire parsing, and streaming quant indicators (Welford, EWMA, Cont OFI, VPIN, Roll spread)."
maintainer: ["Abhradeep Basak <abhradeepbasak07@gmail.com>"]
authors: ["Abhradeep Basak <abhradeepbasak07@gmail.com>"]
license: "MIT"
homepage: "https://github.com/cryogenicdeadfrost/obook"
bug-reports: "https://github.com/cryogenicdeadfrost/obook/issues"
depends: [
  "ocaml" {>= "4.13.0"}
  "dune" {>= "2.9"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
