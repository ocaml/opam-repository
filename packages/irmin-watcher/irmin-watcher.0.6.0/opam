  "dune" {>= "2.8"}
  "ocaml" {>= "5.2.0"}
  "alcotest" {with-test}
  "mtime" {>= "2.1.0"}
  "inotify" {>= "2.6" & os = "linux"}
  "inotify-eio" {>= "2.6" & os = "linux"}
  "cf-lwt" {>= "0.4" & os = "macos"}
  "lwt" {os = "macos"}
  "eio" {>= "1.6"}
  "optint"
  "eio_main" {with-test & >= "1.0"}
  "logs"
