  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    # Bisect_ppx prints OCaml code a lot while testing and it is shaky between compiler versions
    "@runtest" {with-test & ocaml:version >= "5.3.0" }
    "@doc" {with-doc}
  ]
]
