opam-version: "2.0"
synopsis: "Probabilistic inference for OCaml"
description:
  "Bayesian inference over the user's own structures: distributions, bijectors, a model language of generative functions, NUTS, HMC and ensemble samplers batched over chains, nested sampling and tempered SMC for the evidence, Gaussian approximations, draws and diagnostics. Built on Nx, Rune and Jera."
maintainer: ["Thibaut Mattio <thibaut.mattio@gmail.com>"]
authors: ["Thibaut Mattio <thibaut.mattio@gmail.com>"]
license: "ISC"
tags: ["bayesian" "inference" "mcmc" "probabilistic-programming"]
homepage: "https://github.com/raven-ml/raven"
doc: "https://raven-ml.dev/docs/"
bug-reports: "https://github.com/raven-ml/raven/issues"
depends: [
  "ocaml" {>= "5.5.0"}
  "dune" {>= "3.22"}
  "nx" {= version}
  "rune" {= version}
  "jera" {= version}
  "windtrap" {with-test & >= "0.3.1"}
  "mdx" {with-test}
  "thumper" {with-test & >= "0.1.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
