opam-version: "2.0"
synopsis: "Validate Lithuanian personal codes, company codes, VAT numbers and IBANs"
description: """
Checks for Lithuanian personal codes (asmens kodas), company codes, VAT
numbers and IBANs, and a helper that reads the birth date stored in a
personal code. No dependencies beyond the standard library."""
maintainer: ["Justas Arbatauskis <info@kokybiskasvetaine.lt>"]
authors: ["Justas Arbatauskis"]
license: "MIT"
tags: ["lithuania" "validation" "iban" "vat"]
homepage: "https://kokybiskasvetaine.lt/"
bug-reports: "https://github.com/ello-lithuania/ltcodes/issues"
dev-repo: "git+https://github.com/ello-lithuania/ltcodes.git"
depends: [
  "ocaml" {>= "4.13"}
  "dune" {>= "3.0"}
]
build: [
  ["dune" "build" "--root" "ocaml" "-p" name "-j" jobs]
  ["dune" "test" "--root" "ocaml" "-p" name "-j" jobs] {with-test}
]
