opam-version: "2.0"
browse: "https://opam.ocaml.org/pkg/"
upstream: "https://github.com/ocaml/opam-repository/tree/master/"
archive-mirrors: "https://opam.ocaml.org/cache"
announce: [
"""
[INFO] opam is out-of-date. Please consider updating (https://opam.ocaml.org/doc/Install.html)
""" { opam-version < "2.0.10" |
      (opam-version >= "2.1.0~~" & opam-version < "2.1.6") |
      (opam-version >= "2.2.0~~" & opam-version < "2.2.1") |
      (opam-version >= "2.3.0~~" & opam-version < "2.3.0") |
      (opam-version >= "2.4.0~~" & opam-version < "2.4.1") |
      (opam-version >= "2.5.0~~" & opam-version < "2.5.2") |
      (opam-version >= "2.6.0~~" & opam-version < "2.6.0") }
"""
[INFO] please ensure to have GNU patch installed as `patch`. Otherwise update may fail silently (since it can't remove files).
""" {opam-version < "2.1.6" | (opam-version >= "2.2.0~~" & opam-version < "2.2.0~beta2")}
"""
[WARNING] opam >= 2.5.2 includes important security fixes; please consider upgrading (https://opam.ocaml.org/doc/Install.html)
""" {opam-version < "2.3.0" | (opam-version >= "2.4.0~~" & opam-version < "2.5.2")}
"""
[INFO] opam >= 2.6.0 includes extreme performance improvements on Windows; please consider upgrading (https://opam.ocaml.org/doc/Install.html)
""" {(os = "win32" | os = "cygwin") & opam-version < "2.6.0"}
]
